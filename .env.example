# Notary configuration.
#
# Copy to .env and fill in. Everything here has a working default EXCEPT the
# credentials, and the defaults run the app in replay mode with none of them.

# --- Mode -------------------------------------------------------------------
# replay | hybrid | live
NOTARY_MODE=replay

# --- Backblaze B2 -----------------------------------------------------------
NOTARY_B2_KEY_ID=
NOTARY_B2_APPLICATION_KEY=
NOTARY_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
NOTARY_B2_REGION=us-west-004

# The vault MUST be created with Object Lock enabled. It cannot be added later.
# scripts/bootstrap_b2.py does this and verifies it.
NOTARY_B2_BUCKET_VAULT=notary-vault
NOTARY_B2_BUCKET_WORKBENCH=notary-workbench

# Friendly URL base for credential-free <video> playback, e.g.
# https://f004.backblazeb2.com/file/notary-vault
# Leave blank to serve via the S3 endpoint.
NOTARY_B2_PUBLIC_VAULT_BASE=

# Object Lock retention. IRREVERSIBLE: nothing can delete a sealed object
# before this lapses, including you. Keep it short in development.
NOTARY_VAULT_RETENTION_DAYS=7
NOTARY_WORKBENCH_EXPIRY_DAYS=3

# --- Providers --------------------------------------------------------------
NOTARY_GMICLOUD_API_KEY=
NOTARY_LUMA_API_KEY=
NOTARY_OPENAI_API_KEY=

NOTARY_IMAGE_MODEL=seedream-5.0-lite
NOTARY_VIDEO_MODEL=kling-image2video-v2.1-master
NOTARY_VIDEO_FALLBACK_MODEL=ray-2
NOTARY_BOARD_VISION_MODEL=qwen2.5-vl-72b-instruct

NOTARY_STEP_TIMEOUT_SECONDS=600

# Draft plus two verdict-conditioned revisions. Exhausting this escalates to a
# human; it never becomes an approval.
NOTARY_MAX_BOARD_ITERATIONS=3

# --- Provenance (Genblaze Trust Mode 2) -------------------------------------
NOTARY_SIGNING_KEY_PATH=keys/notary-ed25519.pem
NOTARY_SIGNING_KEY_ID=notary-dev-2026

# Fail closed: refuse to issue an unsigned certificate from a Mode 2 deployment.
NOTARY_REQUIRE_SIGNING=true

# --- Service ----------------------------------------------------------------
NOTARY_LOG_LEVEL=INFO
NOTARY_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
