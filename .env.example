# Notary configuration.
#
# Copy to .env and fill in. Everything here has a working default EXCEPT the
# credentials, and the defaults run the app in replay mode with none of them.

# --- Mode -------------------------------------------------------------------
# replay | hybrid | live
NOTARY_MODE=replay

# --- Backblaze B2 -----------------------------------------------------------
NOTARY_B2_KEY_ID=
NOTARY_B2_APPLICATION_KEY=

# COPY THESE FROM YOUR BUCKET PAGE. The region is embedded in the endpoint B2
# shows you (e.g. "s3.us-east-005.backblazeb2.com" -> region us-east-005).
# Guessing wrong produces a 403 on every call, which reads like a credentials
# problem and is not one.
NOTARY_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
NOTARY_B2_REGION=us-east-005

# Bucket names are globally unique across all of Backblaze, so plain
# "notary-vault" is taken. Use your own suffix.
#
# The vault MUST be created with Object Lock ENABLED -- it cannot be added
# later. The workbench must have it DISABLED, or the Lifecycle Rule cannot
# expire drafts and you accumulate undeletable junk.
NOTARY_B2_BUCKET_VAULT=notary-vault-prajwal
NOTARY_B2_BUCKET_WORKBENCH=notary-workbench-prajwal

# Only set this for a PUBLIC bucket, as the friendly URL base:
#   https://f005.backblazeb2.com/file/notary-vault-prajwal
#
# Leave BLANK for a private bucket. Notary then serves certified media through
# /api/certificates/{id}/asset, which mints a fresh presigned URL per request --
# so the certificate carries a durable link even though storage is private.
NOTARY_B2_PUBLIC_VAULT_BASE=

# Where this API is reachable. Baked into certificates as the durable asset
# URL when the vault is private, so it must be the public origin in a real
# deployment, not localhost.
NOTARY_PUBLIC_BASE_URL=http://localhost:8000

# Object Lock retention. IRREVERSIBLE: nothing can delete a sealed object
# before this lapses, including you. Keep it short in development.
NOTARY_VAULT_RETENTION_DAYS=7
NOTARY_WORKBENCH_EXPIRY_DAYS=3

# --- Providers --------------------------------------------------------------
NOTARY_GMICLOUD_API_KEY=
NOTARY_LUMA_API_KEY=
NOTARY_OPENAI_API_KEY=

# Google AI Studio (aistudio.google.com/apikey). Gemini's free tier covers
# vision, and the Board reviews EVERY take including the ones it rejects, so
# per-call cost decides whether the perceptual half can run at all.
#
# Vision and generation are separate on purpose: this key alone lets the Board
# work even with no generation credits anywhere.
NOTARY_GOOGLE_API_KEY=

# Which connector runs the Board: google | gmicloud | openai | nvidia
NOTARY_BOARD_VISION_PROVIDER=google

# Model ids VERIFIED against a live GMI Cloud account by listing /v1/models
# and the connector's registries. Ids are case-sensitive.
#
# Left empty: GMI Cloud's image registry currently exposes only editing models
# (they need an input image), so there is no text-to-image model to chain from.
# With this blank, the pipeline runs text-to-video directly. Set it to a real
# t2i model id to re-enable the chained storyboard step.
NOTARY_IMAGE_MODEL=

# Used when IMAGE_MODEL is blank (text-to-video).
NOTARY_VIDEO_MODEL=Kling-Text2Video-V2.1-Master

# Used instead when IMAGE_MODEL is set, so the keyframe is what gets animated.
NOTARY_CHAINED_VIDEO_MODEL=Kling-Image2Video-V2.1-Master

# A different model family on purpose, so a Kling-side fault has somewhere to go.
NOTARY_VIDEO_FALLBACK_MODEL=seedance-2-0-260128

# Multimodal and cheap, which matters because the Board reviews every take
# including the rejected ones. openai/gpt-5.1 is the stronger fallback.
# A Gemini id when the provider is google (no vendor prefix).
# Use openai/gpt-5.1 style ids only for the gmicloud provider.
NOTARY_BOARD_VISION_MODEL=gemini-2.0-flash

NOTARY_STEP_TIMEOUT_SECONDS=600

# Draft plus two verdict-conditioned revisions. Exhausting this escalates to a
# human; it never becomes an approval.
NOTARY_MAX_BOARD_ITERATIONS=3

# --- Provenance (Genblaze Trust Mode 2) -------------------------------------
NOTARY_SIGNING_KEY_PATH=keys/notary-ed25519.pem
NOTARY_SIGNING_KEY_ID=notary-dev-2026

# Fail closed: refuse to issue an unsigned certificate from a Mode 2 deployment.
NOTARY_REQUIRE_SIGNING=true

# --- Service ----------------------------------------------------------------
NOTARY_LOG_LEVEL=INFO
NOTARY_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
