# Signing keys. Anyone holding the private key can issue certificates in this
# deployment's name — this must never be committed.
keys/
*.pem

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node
node_modules/
frontend/dist/
*.local

# Seeded demo recordings are committed on purpose — they are what makes the
# deployed app usable without credentials. Ignore only ad-hoc captures.
seed/tmp-*/
seed/scratch-*/

# Internal planning/strategy document. Not part of the deliverable and not
# intended for a public repository.
notary.md

# Written by scripts/seed_vault.py for offline verification.
/certificate.json

# No video in the repository, anywhere. A browser capture was committed once
# by a broad `git add -A`, and 30 MB of it sat in history where every clone
# paid for it. Generated and sample media belong outside version control --
# scripts/seed_vault.py takes any local file as an argument.
*.mp4
*.mov
*.webm
*.mkv

# Local narrated walkthrough, for screen-recording the submission video.
# Not part of the product and not something a judge should find in the repo.
demo.html
kling-render.mp4

# Agent tooling state, not project source. .claude/ contains embedded git
# worktrees, which would otherwise be staged as a nested repository.
.superpowers/
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
